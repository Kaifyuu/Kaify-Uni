                <div class="d-flex justify-content-between mb-3">
                    <strong>Total:</strong>
                    <strong id="cartTotal">$0.00</strong>
                </div>
                <button class="btn btn-success w-100" onclick="alert('Proceeding to Checkout UI...')">Checkout</button>
                <button class="btn btn-link text-danger w-100 mt-2" id="clearCartBtn">Clear Cart</button>
